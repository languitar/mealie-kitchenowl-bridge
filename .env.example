# Copy to .env and fill in real values.

KITCHENOWL_URL=https://kitchenowl.example.com
KITCHENOWL_API_TOKEN=changeme
# The household whose shopping lists get offered/pushed to (single static
# household - see AGENTS.md's deferred multi-user/multi-household decision).
KITCHENOWL_HOUSEHOLD_ID=1

# Shared secret Mealie's recipe action must send as a `token` query parameter on its
# webhook call to /recipes/action (e.g.
# https://bridge.example.com/recipes/action?token=...&slug=${slug}).
# Required - the app refuses to start without this set.
WEBHOOK_TOKEN=changeme

# Used to fetch the triggering recipe's ingredients server-side by slug (Mealie's
# "Link"-type recipe action only carries the recipe slug, not its data - see README).
# MEALIE_API_TOKEN is a long-lived API token, generated in Mealie's user profile.
# Both required - the app refuses to start without them set.
MEALIE_URL=https://mealie.example.com
MEALIE_API_TOKEN=changeme
