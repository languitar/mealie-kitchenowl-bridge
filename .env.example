# Copy to .env and fill in real values.

KITCHENOWL_URL=https://kitchenowl.example.com
KITCHENOWL_API_TOKEN=changeme
# The household whose shopping lists get offered/pushed to (single static
# household - see AGENTS.md's deferred multi-user/multi-household decision).
KITCHENOWL_HOUSEHOLD_ID=1

# OIDC login gates every page of the bridge (see README's Configuration section).
# OIDC_ISSUER is the bare issuer URL of your identity provider - the bridge
# discovers the rest from {OIDC_ISSUER}/.well-known/openid-configuration.
# Register the bridge as a confidential client with your provider, with
# https://bridge.example.com/auth/callback as an allowed redirect URI.
# All three required - the app refuses to start without them set.
OIDC_ISSUER=https://idp.example.com/realms/bridge
OIDC_CLIENT_ID=changeme
OIDC_CLIENT_SECRET=changeme

# Signs the login session cookie. Required - the app refuses to start without
# this set. Keep it stable across restarts (rotating it logs everyone out) and
# generate it with real randomness, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Used to fetch the triggering recipe's ingredients server-side by slug (Mealie's
# "Link"-type recipe action only carries the recipe slug, not its data - see README).
# MEALIE_API_TOKEN is a long-lived API token, generated in Mealie's user profile.
# Both required - the app refuses to start without them set.
MEALIE_URL=https://mealie.example.com
MEALIE_API_TOKEN=changeme
