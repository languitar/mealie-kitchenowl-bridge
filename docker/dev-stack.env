# Fixed (non-secret-rotating) config for the bridge service when running the
# local dev stack (see docker-compose.yml and README's "Local dev stack"
# section). Committed on purpose - all values here are throwaway, dev-only.
#
# The tokens that actually depend on a freshly-seeded Mealie/KitchenOwl
# instance (KITCHENOWL_API_TOKEN, KITCHENOWL_HOUSEHOLD_ID, MEALIE_API_TOKEN)
# are NOT here - the seed service mints them at startup and writes them to
# the shared seed_env volume, which the bridge container sources itself.

KITCHENOWL_URL=http://127.0.0.1:8080

# Authelia, run as this stack's OIDC provider (see docker/authelia/). Its
# client_id/client_secret here are throwaway dev-stack values matching
# docker/authelia/configuration.yml - never reuse them elsewhere.
OIDC_ISSUER=https://127.0.0.1:9091
OIDC_CLIENT_ID=bridge
OIDC_CLIENT_SECRET=4b5e4d4aa64fb92d8c0df0de0964f837e8f65be1df3bb60634a0ba6f9cf3bae9

# Throwaway session-signing secret for the dev stack only.
SECRET_KEY=75ae73c3b84ca7bcd59ac2e965f9ea3097d546baade77e4f8672c25ed0429d39

MEALIE_URL=http://127.0.0.1:9000
